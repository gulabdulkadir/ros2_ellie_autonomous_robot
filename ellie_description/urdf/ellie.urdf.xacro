<?xml version="1.0"?>
<robot name="ellie" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_properties.xacro" />

    <xacro:property name="base_length" value="0.4" />
    <xacro:property name="base_width" value="0.3" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="base_mass" value="2.0" />

    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_length" value="0.04" />
    <xacro:property name="wheel_mass" value="0.2" />

    <xacro:property name="caster_radius" value="0.05" />
    <xacro:property name="caster_mass" value="0.05" />

    <xacro:include filename="ellie_gazebo.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="camera.xacro" />
    
    <xacro:macro name="wheel" params="prefix y_reflect">
        <link name="${prefix}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="dark_gray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}" xyz="0 0 0" rpy="0 0 0"/>
        </link>

        <joint name="base_to_${prefix}_wheel" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="-0.1 ${y_reflect * (base_width / 2.0 + wheel_length / 2.0)} ${wheel_radius / 2.0}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
    </link>

    <xacro:wheel prefix="left" y_reflect="1" />
    <xacro:wheel prefix="right" y_reflect="-1" />

    <link name="caster_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <joint name="base_to_caster" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="0.15 0 ${caster_radius / 2.0}" rpy="0 0 0"/>
    </joint>

</robot>